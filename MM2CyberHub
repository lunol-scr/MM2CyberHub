-- Телепортация по клику
local clickTeleportConnection = nil

local function startClickTeleport()
	if clickTeleportConnection then return end
	clickTeleportConnection = UserInputService.InputBegan:Connect(function(input, gameProcessed)
		if gameProcessed then return end
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			local character = player.Character
			local rootPart = character and character:FindFirstChild("HumanoidRootPart")
			local camera = workspace.CurrentCamera
			if not rootPart or not camera then return end

			local mousePos = UserInputService:GetMouseLocation()
			local ray = camera:ScreenPointToRay(mousePos.X, mousePos.Y)
			local raycastParams = RaycastParams.new()
			raycastParams.FilterType = Enum.RaycastFilterType.Blacklist
			raycastParams.FilterDescendantsInstances = {character}
			local result = workspace:Raycast(ray.Origin, ray.Direction * 1000, raycastParams)
			if result then
				rootPart.CFrame = CFrame.new(result.Position + Vector3.new(0, 3, 0))
				print("Телепортация к " .. tostring(result.Position))
			end
		end
	end)
end

local function stopClickTeleport()
	if clickTeleportConnection then
		clickTeleportConnection:Disconnect()
		clickTeleportConnection = nil
	end
end

addToggle("Телепортация", "Телепортация", "Кликните по экрану, чтобы телепортироваться.", function(enabled)
	if enabled then
		startClickTeleport()
	else
		stopClickTeleport()
	end
end, false)

-- ================== АВТОФАРМ COIN_SERVER ==================
local autoFarmHeartbeat = nil
local autoFarmUpdateThread = nil
local autoFarmRestartTimer = nil
local autoFarmSpeed = 24
local currentTargetCoin = nil
local coinList = {}
local autoFarmNoClipForced = false
local autoFarmGodForced = false
local autoFarmBodyVelocity = nil
local autoFarmBodyGyro = nil

local function updateCoinList()
	coinList = {}
	local allObjects = workspace:GetDescendants()
	for _, obj in ipairs(allObjects) do
		if obj.Name == "Coin_Server" then
			local position = nil
			if obj:IsA("BasePart") then
				position = obj.Position
			elseif obj:IsA("Model") and obj.PrimaryPart then
				position = obj.PrimaryPart.Position
			end
			if position then
				table.insert(coinList, position)
			end
		end
	end
end

local function findClosestCoin()
	if #coinList == 0 then return nil end
	local rootPart = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	if not rootPart then return nil end
	local closestDistance = math.huge
	local closestPos = nil
	for _, pos in ipairs(coinList) do
		local distance = (pos - rootPart.Position).Magnitude
		if distance < closestDistance then
			closestDistance = distance
			closestPos = pos
		end
	end
	return closestPos
end

local function removeCoinFromList(pos)
	for i, p in ipairs(coinList) do
		if p == pos then
			table.remove(coinList, i)
			break
		end
	end
end

stopAutoFarm = function()
	autoFarmRunning = false
	if autoFarmHeartbeat then autoFarmHeartbeat:Disconnect(); autoFarmHeartbeat = nil end
	if autoFarmUpdateThread then autoFarmUpdateThread = nil end
	if autoFarmRestartTimer then autoFarmRestartTimer = nil end
	if autoFarmBodyVelocity then autoFarmBodyVelocity:Destroy(); autoFarmBodyVelocity = nil end
	if autoFarmBodyGyro then autoFarmBodyGyro:Destroy(); autoFarmBodyGyro = nil end
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if humanoid then humanoid.PlatformStand = false end
	currentTargetCoin = nil
	coinList = {}
	if autoFarmNoClipForced and noClipEntry then noClipEntry.setState(false); autoFarmNoClipForced = false end
	if autoFarmGodForced and godEntry then godEntry.setState(false); autoFarmGodForced = false end
end

local function startAutoFarm()
	if autoFarmRunning then return end
	autoFarmRunning = true

	if noClipEntry and not noClipEntry.state then noClipEntry.setState(true); autoFarmNoClipForced = true end
	if godEntry and not godEntry.state then godEntry.setState(true); autoFarmGodForced = true end

	local character = player.Character
	local rootPart = character and character:FindFirstChild("HumanoidRootPart")
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not rootPart or not humanoid then stopAutoFarm(); return end

	autoFarmBodyVelocity = Instance.new("BodyVelocity")
	autoFarmBodyVelocity.MaxForce = Vector3.new(1000000, 1000000, 1000000)
	autoFarmBodyVelocity.Velocity = Vector3.zero
	autoFarmBodyVelocity.Parent = rootPart

	autoFarmBodyGyro = Instance.new("BodyGyro")
	autoFarmBodyGyro.MaxTorque = Vector3.new(1000000, 1000000, 1000000)
	autoFarmBodyGyro.CFrame = rootPart.CFrame
	autoFarmBodyGyro.Parent = rootPart

	humanoid.PlatformStand = true

	updateCoinList()
	currentTargetCoin = findClosestCoin()
	if not currentTargetCoin then stopAutoFarm(); return end

	autoFarmUpdateThread = task.spawn(function()
		while autoFarmRunning do
			task.wait(2)
			if autoFarmRunning then
				updateCoinList()
				if currentTargetCoin then
					local stillExists = false
					for _, p in ipairs(coinList) do
						if p == currentTargetCoin then stillExists = true; break end
					end
					if not stillExists then currentTargetCoin = findClosestCoin() end
				end
			end
		end
	end)

	autoFarmRestartTimer = task.spawn(function()
		while autoFarmRunning do
			task.wait(60)
			if autoFarmRunning then
				print("Перезапуск автофарма...")
				local savedSpeed = autoFarmSpeed
				stopAutoFarm()
				task.wait(0.1)
				autoFarmSpeed = savedSpeed
				startAutoFarm()
			end
		end
	end)

	autoFarmHeartbeat = game:GetService("RunService").Heartbeat:Connect(function(dt)
		if not autoFarmRunning then return end
		if not rootPart or not rootPart.Parent then stopAutoFarm(); return end

		if not currentTargetCoin then
			currentTargetCoin = findClosestCoin()
			if not currentTargetCoin then autoFarmBodyVelocity.Velocity = Vector3.zero; return end
		end

		local targetPos = currentTargetCoin
		local direction = targetPos - rootPart.Position
		local distance = direction.Magnitude

		if distance < 0.1 then
			removeCoinFromList(currentTargetCoin)
			currentTargetCoin = findClosestCoin()
			return
		else
			local speed = autoFarmSpeed
			if distance < 5 then speed = math.min(speed, distance * 10) end
			autoFarmBodyVelocity.Velocity = direction.Unit * speed
			autoFarmBodyGyro.CFrame = CFrame.lookAt(rootPart.Position, targetPos)
		end
	end)
end

addToggle("Телепортация", "Автофарм Coin_Server", "Летает к ближайшим монетам. Скорость настраивается.", function(enabled, valueText)
	if enabled then
		if valueText then
			local speed = tonumber(valueText)
			if speed and speed > 0 then autoFarmSpeed = speed else autoFarmSpeed = 24 end
		end
		startAutoFarm()
	else
		stopAutoFarm()
	end
end, false, true, "24")

