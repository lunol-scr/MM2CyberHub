-- Скорость
local currentSpeed = nil
local function applySpeed(enabled, valueText)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not humanoid then return end
	if enabled then
		local speed = tonumber(valueText)
		if speed and speed > 0 then
			humanoid.WalkSpeed = speed
			currentSpeed = speed
			print("Скорость установлена на " .. speed)
		else
			print("Неверное значение скорости")
			currentSpeed = nil
		end
	else
		humanoid.WalkSpeed = 16
		currentSpeed = nil
		print("Скорость сброшена на 16")
	end
end

