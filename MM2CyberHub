-- Скорость
local currentSpeed = nil
local function applySpeed(enabled, valueText)
	local char = player.Character
	local humanoid = char and char:FindFirstChildOfClass("Humanoid")
	if not humanoid then return end
	if enabled then
		local speed = tonumber(valueText)
		if speed then
			humanoid.WalkSpeed = speed
			currentSpeed = speed
			print("Скорость установлена на " .. speed)
		end
	else
		humanoid.WalkSpeed = 16
		currentSpeed = nil
		print("Скорость сброшена")
	end
end
addToggle("Персонаж", "Скорость", "Скорость ходьбы", applySpeed, false, true, "16")

