local joystickVector = Vector2.new(0, 0) -- x: влево/вправо, y: вперёд(-1)/назад(1)
local joystickInputId = nil
local joystickRadius = 40 -- максимальное смещение ручки от центра

local upHeld = false
local downHeld = false

local function resetJoystick()
	joystickInputId = nil
	joystickVector = Vector2.new(0, 0)
	TweenService:Create(joystickKnob, TweenInfo.new(0.15), {Position = UDim2.new(0.5, 0, 0.5, 0)}):Play()
end

joystickBG.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
		joystickInputId = input
		local center = joystickBG.AbsolutePosition + joystickBG.AbsoluteSize / 2
		local pos = Vector2.new(input.Position.X, input.Position.Y)
		local offset = pos - center
		if offset.Magnitude > joystickRadius then
			offset = offset.Unit * joystickRadius
		end
		joystickKnob.Position = UDim2.new(0.5, offset.X, 0.5, offset.Y)
		joystickVector = Vector2.new(offset.X / joystickRadius, offset.Y / joystickRadius)
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if joystickInputId and input == joystickInputId then
		local center = joystickBG.AbsolutePosition + joystickBG.AbsoluteSize / 2
		local pos = Vector2.new(input.Position.X, input.Position.Y)
		local offset = pos - center
		if offset.Magnitude > joystickRadius then
			offset = offset.Unit * joystickRadius
		end
		joystickKnob.Position = UDim2.new(0.5, offset.X, 0.5, offset.Y)
		joystickVector = Vector2.new(offset.X / joystickRadius, offset.Y / joystickRadius)
	end
end)

UserInputService.InputEnded:Connect(function(input)
	if joystickInputId and input == joystickInputId then
		resetJoystick()
	end
	if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
		upHeld = false
		downHeld = false
	end
end)

