local function addToggle(category, name, description, callback, defaultEnabled, hasInput, placeholder)
	local parentScroll = categories[category]
	if not parentScroll then
		warn("Категория " .. category .. " не найдена")
		return
	end

	local rowHeight = hasInput and 84 or 56
	local row = Instance.new("Frame")
	row.Name = name
	row.Size = UDim2.new(1, 0, 0, rowHeight)
	row.BackgroundColor3 = COLORS.row
	row.BackgroundTransparency = 0.2
	row.BorderSizePixel = 0
	row.Parent = parentScroll

	local rowStroke = Instance.new("UIStroke")
	rowStroke.Color = COLORS.border
	rowStroke.Thickness = 1
	rowStroke.Parent = row

	local nameLabel = Instance.new("TextLabel")
	nameLabel.Size = UDim2.new(0.7, -10, 0, 20)
	nameLabel.Position = UDim2.new(0, 8, 0, 6)
	nameLabel.BackgroundTransparency = 1
	nameLabel.Text = name
	nameLabel.TextColor3 = COLORS.text
	nameLabel.Font = Enum.Font.GothamSemibold
	nameLabel.TextSize = 14
	nameLabel.TextXAlignment = Enum.TextXAlignment.Left
	nameLabel.Parent = row

	local descLabel = Instance.new("TextLabel")
	descLabel.Size = UDim2.new(0.7, -10, 0, 24)
	descLabel.Position = UDim2.new(0, 8, 0, 26)
	descLabel.BackgroundTransparency = 1
	descLabel.Text = description
	descLabel.TextColor3 = COLORS.subText
	descLabel.Font = Enum.Font.Gotham
	descLabel.TextSize = 12
	descLabel.TextXAlignment = Enum.TextXAlignment.Left
	descLabel.TextWrapped = true
	descLabel.Parent = row

	local inputBox
	if hasInput then
		inputBox = Instance.new("TextBox")
		inputBox.Size = UDim2.new(0, 70, 0, 24)
		inputBox.Position = UDim2.new(0, 8, 0, 52)
		inputBox.BackgroundColor3 = COLORS.inputBackground
		inputBox.BackgroundTransparency = 0.2
		inputBox.BorderSizePixel = 0
		inputBox.Text = placeholder or ""
		inputBox.TextColor3 = COLORS.text
		inputBox.Font = Enum.Font.Gotham
		inputBox.TextSize = 13
		inputBox.PlaceholderText = placeholder or "Введите значение"
		inputBox.PlaceholderColor3 = COLORS.subText
		inputBox.TextXAlignment = Enum.TextXAlignment.Center
		inputBox.Parent = row
	end

	local toggleButton = Instance.new("TextButton")
	toggleButton.Size = UDim2.new(0, 56, 0, 26)
	toggleButton.Position = UDim2.new(1, -64, 0.5, -13)
	toggleButton.BackgroundColor3 = defaultEnabled and COLORS.toggleOn or COLORS.toggleOff
	toggleButton.BorderSizePixel = 0
	toggleButton.Text = defaultEnabled and "ON" or "OFF"
	toggleButton.TextColor3 = Color3.new(1, 1, 1)
	toggleButton.Font = Enum.Font.GothamBold
	toggleButton.TextSize = 12
	toggleButton.AutoButtonColor = false
	toggleButton.Parent = row

	row.MouseEnter:Connect(function()
		TweenService:Create(row, TweenInfo.new(0.2), {BackgroundColor3 = COLORS.rowHover}):Play()
	end)
	row.MouseLeave:Connect(function()
		TweenService:Create(row, TweenInfo.new(0.2), {BackgroundColor3 = COLORS.row}):Play()
	end)

	local state = defaultEnabled
	local entry = {}

	local function setState(newState)
		state = newState
		entry.state = newState
		local targetColor = newState and COLORS.toggleOn or COLORS.toggleOff
		TweenService:Create(toggleButton, TweenInfo.new(0.15), {BackgroundColor3 = targetColor}):Play()
		toggleButton.Text = newState and "ON" or "OFF"
		if callback then
			local success, err = pcall(callback, newState, inputBox and inputBox.Text or nil)
			if not success then
				warn("Ошибка в функции " .. name .. ": " .. tostring(err))
			end
		end
	end

	entry = {
		row = row,
		button = toggleButton,
		state = state,
		setState = setState,
		callback = callback,
		connection = nil,
		inputBox = inputBox,
		inputConnection = nil
	}

	entry.connection = toggleButton.MouseButton1Click:Connect(function()
		setState(not state)
	end)

	if inputBox then
		entry.inputConnection = inputBox.FocusLost:Connect(function()
			if state and inputBox.Text ~= "" then
				if callback then
					local success, err = pcall(callback, true, inputBox.Text)
					if not success then
						warn("Ошибка при обновлении " .. name .. ": " .. tostring(err))
					end
				end
			end
		end)
	end

	if defaultEnabled then
		setState(true)
	end

	table.insert(toggles, entry)
	return entry
end

