-- ================== АВТОФАРМ (с исправлением "возврата" по уже собранным монетам) ==================
-- Теперь список монет хранит ссылки на сами объекты (Instance), а не только
-- координаты. Плюс добавлен временный "чёрный список" недавно посещённых
-- монет (visitedCoins), чтобы фоновое пересканирование workspace не
-- подсовывало снова ту же монету, если сервер ещё не успел её удалить -
-- именно это раньше приводило к тому, что персонаж улетал обратно.
local autoFarmHeartbeat = nil
local autoFarmUpdateThread = nil
local autoFarmRestartTimer = nil
local autoFarmSpeed = 24
local currentTargetCoin = nil -- теперь это {instance = obj, position = Vector3}
local coinList = {} -- список записей {instance = obj, position = Vector3}
local visitedCoins = {} -- [instance] = os.clock() времени последнего посещения
local VISITED_COOLDOWN = 3 -- секунд, в течение которых монета игнорируется после "посещения"
local autoFarmNoClipForced = false
local autoFarmGodForced = false
local autoFarmBodyVelocity = nil
local autoFarmBodyGyro = nil

local function updateCoinList()
	coinList = {}
	local now = os.clock()
	local allObjects = workspace:GetDescendants()
	for _, obj in ipairs(allObjects) do
		if obj.Name == "Coin_Server" then
			local position = nil
			if obj:IsA("BasePart") then
				position = obj.Position
			elseif obj:IsA("Model") and obj.PrimaryPart then
				position = obj.PrimaryPart.Position
			end
			if position then
				local visitedAt = visitedCoins[obj]
				if not visitedAt or (now - visitedAt) > VISITED_COOLDOWN then
					table.insert(coinList, {instance = obj, position = position})
				end
			end
		end
	end
	-- Чистим устаревшие записи посещённых монет, чтобы таблица не росла бесконечно
	for obj, t in pairs(visitedCoins) do
		if (not obj.Parent) or (now - t) > VISITED_COOLDOWN then
			visitedCoins[obj] = nil
		end
	end
end

local function findClosestCoin()
	if #coinList == 0 then return nil end
	local rootPart = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	if not rootPart then return nil end
	local closestDistance = math.huge
	local closestEntry = nil
	for _, entry in ipairs(coinList) do
		local distance = (entry.position - rootPart.Position).Magnitude
		if distance < closestDistance then
			closestDistance = distance
			closestEntry = entry
		end
	end
	return closestEntry
end

local function removeCoinFromList(instanceObj)
	for i, entry in ipairs(coinList) do
		if entry.instance == instanceObj then
			table.remove(coinList, i)
			break
		end
	end
end

stopAutoFarm = function()
	autoFarmRunning = false
	if autoFarmHeartbeat then autoFarmHeartbeat:Disconnect(); autoFarmHeartbeat = nil end
	if autoFarmUpdateThread then autoFarmUpdateThread = nil end
	if autoFarmRestartTimer then autoFarmRestartTimer = nil end
	if autoFarmBodyVelocity then autoFarmBodyVelocity:Destroy(); autoFarmBodyVelocity = nil end
	if autoFarmBodyGyro then autoFarmBodyGyro:Destroy(); autoFarmBodyGyro = nil end
	local char = player.Character
	local humanoid = char and char:FindFirstChildOfClass("Humanoid")
	if humanoid then humanoid.PlatformStand = false end
	currentTargetCoin = nil
	coinList = {}
	if autoFarmNoClipForced and noClipEntry then noClipEntry.setState(false); autoFarmNoClipForced = false end
	if autoFarmGodForced and godEntry then godEntry.setState(false); autoFarmGodForced = false end
end

local function startAutoFarm()
	if autoFarmRunning then return end
	autoFarmRunning = true

	if noClipEntry and not noClipEntry.state then noClipEntry.setState(true); autoFarmNoClipForced = true end
	if godEntry and not godEntry.state then godEntry.setState(true); autoFarmGodForced = true end

	local char = player.Character
	local rootPart = char and char:FindFirstChild("HumanoidRootPart")
	local humanoid = char and char:FindFirstChildOfClass("Humanoid")
	if not rootPart or not humanoid then stopAutoFarm(); return end

	autoFarmBodyVelocity = Instance.new("BodyVelocity")
	autoFarmBodyVelocity.MaxForce = Vector3.new(1000000, 1000000, 1000000)
	autoFarmBodyVelocity.Velocity = Vector3.zero
	autoFarmBodyVelocity.Parent = rootPart

	autoFarmBodyGyro = Instance.new("BodyGyro")
	autoFarmBodyGyro.MaxTorque = Vector3.new(1000000, 1000000, 1000000)
	autoFarmBodyGyro.CFrame = rootPart.CFrame
	autoFarmBodyGyro.Parent = rootPart

	humanoid.PlatformStand = true

	updateCoinList()
	currentTargetCoin = findClosestCoin()
	if not currentTargetCoin then stopAutoFarm(); return end

	autoFarmUpdateThread = task.spawn(function()
		while autoFarmRunning do
			task.wait(2)
			if autoFarmRunning then
				updateCoinList()
				if currentTargetCoin then
					local stillExists = false
					for _, entry in ipairs(coinList) do
						if entry.instance == currentTargetCoin.instance then stillExists = true; break end
					end
					if not stillExists then currentTargetCoin = findClosestCoin() end
				end
			end
		end
	end)

	autoFarmRestartTimer = task.spawn(function()
		while autoFarmRunning do
			task.wait(60)
			if autoFarmRunning then
				print("Перезапуск автофарма...")
				local savedSpeed = autoFarmSpeed
				stopAutoFarm()
				task.wait(0.1)
				autoFarmSpeed = savedSpeed
				startAutoFarm()
			end
		end
	end)

	autoFarmHeartbeat = game:GetService("RunService").Heartbeat:Connect(function(dt)
		if not autoFarmRunning then return end
		if not rootPart or not rootPart.Parent then stopAutoFarm(); return end

		if not currentTargetCoin then
			currentTargetCoin = findClosestCoin()
			if not currentTargetCoin then autoFarmBodyVelocity.Velocity = Vector3.zero; return end
		end

		-- Если объект монеты уже уничтожен сервером (реально собран) - сразу берём следующую
		if not currentTargetCoin.instance or not currentTargetCoin.instance.Parent then
			removeCoinFromList(currentTargetCoin.instance)
			currentTargetCoin = findClosestCoin()
			return
		end

		local targetPos = currentTargetCoin.position
		local direction = targetPos - rootPart.Position
		local distance = direction.Magnitude

		if distance < 0.1 then
			-- Отмечаем монету как "посещённую" на несколько секунд, чтобы фоновое
			-- пересканирование не подсунуло её снова, пока сервер не удалит объект
			visitedCoins[currentTargetCoin.instance] = os.clock()
			removeCoinFromList(currentTargetCoin.instance)
			currentTargetCoin = findClosestCoin()
			return
		else
			local speed = autoFarmSpeed
			if distance < 5 then speed = math.min(speed, distance * 10) end
			autoFarmBodyVelocity.Velocity = direction.Unit * speed
			autoFarmBodyGyro.CFrame = CFrame.lookAt(rootPart.Position, targetPos)
		end
	end)
end

addToggle("Телепортация", "Автофарм Coin_Server", "Летает к ближайшим монетам. Скорость настраивается.", function(enabled, valueText)
	if enabled then
		if valueText then
			local speed = tonumber(valueText)
			if speed and speed > 0 then autoFarmSpeed = speed else autoFarmSpeed = 24 end
		end
		startAutoFarm()
	else
		stopAutoFarm()
	end
end, false, true, "24")

-- ================== ESP (ПОДСВЕТКА ИГРОКОВ) ==================
-- Клиентская подсветка других игроков через стены (Highlight). Это тоже
-- чисто визуальный эффект локального клиента - на других игроков никак
-- не влияет и не изменяет их видимость для остальных.
local espEnabled = false
local espHighlights = {} -- [character] = Highlight instance
local espCharacterConnections = {} -- [player] = Connection

local function addESPHighlight(char)
	if not char or espHighlights[char] then return end
	local highlight = Instance.new("Highlight")
	highlight.Name = "MM2CyberHub_ESP"
	highlight.FillColor = Color3.fromRGB(255, 60, 60)
	highlight.FillTransparency = 0.5
	highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
	highlight.OutlineTransparency = 0
	highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	highlight.Parent = char
	espHighlights[char] = highlight
end

local function removeESPHighlight(char)
	if char and espHighlights[char] then
		espHighlights[char]:Destroy()
		espHighlights[char] = nil
	end
end

local function setupPlayerESP(plr)
	if plr == player then return end
	if espCharacterConnections[plr] then
		espCharacterConnections[plr]:Disconnect()
	end
	espCharacterConnections[plr] = plr.CharacterAdded:Connect(function(char)
		if espEnabled then
			addESPHighlight(char)
		end
	end)
	if plr.Character and espEnabled then
		addESPHighlight(plr.Character)
	end
end

local function teardownPlayerESP(plr)
	if espCharacterConnections[plr] then
		espCharacterConnections[plr]:Disconnect()
		espCharacterConnections[plr] = nil
	end
	if plr.Character then
		removeESPHighlight(plr.Character)
	end
end

for _, plr in ipairs(Players:GetPlayers()) do
	setupPlayerESP(plr)
end
Players.PlayerAdded:Connect(setupPlayerESP)
Players.PlayerRemoving:Connect(teardownPlayerESP)

local function applyESP(enabled)
	espEnabled = enabled
	if enabled then
		for _, plr in ipairs(Players:GetPlayers()) do
			if plr ~= player and plr.Character then
				addESPHighlight(plr.Character)
			end
		end
		print("ESP игроков включен")
	else
		for char, _ in pairs(espHighlights) do
			removeESPHighlight(char)
		end
		print("ESP игроков выключен")
	end
end
addToggle("Игроки", "ESP игроков", "Подсвечивает игроков сквозь стены", applyESP, false)

