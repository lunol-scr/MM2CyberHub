-- ================== АВТОВОССТАНОВЛЕНИЕ ФУНКЦИЙ ПОСЛЕ СМЕРТИ/РЕСПАВНА ==================
-- При каждом новом появлении персонажа (смерть, начало нового раунда) заново
-- применяем все функции, у которых тумблер в GUI сейчас включён (ON).
-- Это касается всех функций из категории "Персонаж" (скорость, полёт,
-- noclip, бессмертие, невидимость и т.д.), так как их эффекты обычно
-- завязаны на конкретный экземпляр персонажа и пропадают при возрождении.
player.CharacterAdded:Connect(function(char)
	local humanoid = char:WaitForChild("Humanoid", 5)
	local rootPart = char:WaitForChild("HumanoidRootPart", 5)
	if not humanoid or not rootPart then return end
	task.wait(0.2) -- небольшая пауза, чтобы персонаж успел стабилизироваться после спавна
	for _, entry in ipairs(toggles) do
		if entry.state and entry.callback then
			pcall(entry.callback, true, entry.inputBox and entry.inputBox.Text or nil)
		end
	end
end)

